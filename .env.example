# ==============================================================================
# Saarthi Environment Configuration Template
# Copy this file to .env and configure your keys.
# ==============================================================================

# --- Primary LLM Keys ---
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
REPLICATE_API_KEY=your_replicate_api_key_here

# --- Model Selection ---
REPLICATE_MODEL=openai/gpt-4o-mini
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-2.5-flash

# --- Optional Pod B Grounding & Embeddings Configuration ---
# EMBEDDING_PROVIDER=auto    # auto | gemini | local | hash
# LLM_PROVIDER=auto          # auto | gemini | none
# RERANK_PROVIDER=auto       # auto | cross-encoder | lexical
# VERIFY_WITH_LLM=0          # 1 = extra LLM verification pass on retrieved claims
# POD_B_RATE_LIMIT=60        # Max queries per minute per client IP
# POD_B_ADMIN_TOKEN=         # Optional admin token for indexing/rebuild endpoints
