# Copy to .env and uncomment what you have. No keys needed to run: the fallbacks work offline.

# --- Hosted embeddings (optional; first non-empty key wins when EMBEDDING_PROVIDER=auto) ---
# OPENAI_API_KEY=
# GEMINI_API_KEY=            # GOOGLE_API_KEY also works

# --- LLM for graph building (and, in step 4, grounded answers): auto | gemini | none ---
# LLM_PROVIDER=auto
# LLM_MODEL=                 # blank = gemini-2.5-flash; run scripts/check_gemini.py to see what your key can use

# VERIFY_WITH_LLM=0          # 1 = extra LLM call that fact-checks each claim against its cited units (more cost, safer)

# --- Force a backend instead of auto-detecting: auto | openai | gemini | local | hash ---
# EMBEDDING_PROVIDER=auto
# EMBEDDING_MODEL=           # blank = provider default (text-embedding-3-small / gemini-embedding-001 / BAAI/bge-small-en-v1.5)

# --- Reranker: auto | cross-encoder | lexical ---
# RERANK_PROVIDER=auto       # auto = cross-encoder if sentence-transformers is installed, else lexical
# RERANK_MODEL=

# --- Misc ---
# POD_B_CACHE_DIR=.pod_b_cache   # embeddings cache; delete to force re-embedding
# CANDIDATE_POOL=20
# POD_B_CORPUS=path/to/units.json
# POD_B_GRAPH=path/to/graph.json  # default: .pod_b_cache/graph.json if built, else the bundled demo graph

# --- Serving / safety (set these before sharing the server with the team) ---
# POD_B_ADMIN_TOKEN=change-me           # required header X-Admin-Token on /ingest and /graph/rebuild
# POD_B_RATE_LIMIT=60                   # /ask calls per minute per client IP (0 = off); each call can cost LLM tokens
# POD_B_CORS_ORIGINS=http://localhost:5173   # frontend origin(s), comma-separated, or *
# POD_B_SOURCES_DIR=path/to/uploads     # serve originals at /sources/{source_id} (file name without extension)
